  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#526A70",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#00D9F5"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#35D49A"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.language"
      ],
      "settings": {
        "foreground": "#00AFC8"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#E6FAFC"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#087F91"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "meta.definition.variable",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#8BAAB0"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#8BAAB0"
      }
    },
    {
      "name": "Tags and markup",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#00D9F5"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#00AFC8"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#526A70"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#00AFC8"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#00D9F5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E6FAFC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#8BAAB0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#00D9F5",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#35D49A"
      }
    },
    {
      "name": "Diff removals",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#087F91",
    "class": "#087F91",
    "interface": "#087F91",
    "struct": "#087F91",
    "type": "#087F91",
    "enum": "#087F91",
    "typeParameter": "#00AFC8",
    "function": "#E6FAFC",
    "method": "#E6FAFC",
    "macro": "#00D9F5",
    "parameter": "#8BAAB0",
    "variable": "#8BAAB0",
    "property": "#8BAAB0",
    "enumMember": "#00AFC8",
    "keyword": "#00D9F5",
    "comment": {
      "foreground": "#526A70",
      "italic": true
    },
    "string": "#35D49A",
    "number": "#00AFC8",
    "regexp": "#00AFC8",
    "operator": "#526A70",
    "decorator": "#00D9F5"
  }
}
